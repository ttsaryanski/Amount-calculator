<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Display Area -->
    <LinearLayout
        android:id="@+id/displayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/background_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textAuthor">

        <!-- Amount Due Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amount_due"
            android:textColor="@color/light_gray"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editAmountDue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0.00"
                android:textColor="@color/text_light"
                android:textSize="32sp"
                android:inputType="numberDecimal"
                android:background="@android:color/transparent"
                android:textColorHint="@color/light_gray"
                android:padding="8dp" />

            <TextView
                android:id="@+id/textDueCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BGN"
                android:textColor="@color/light_gray"
                android:textSize="24sp"
                android:paddingEnd="8dp"
                android:paddingStart="8dp" />

            <Spinner
                android:id="@+id/spinnerDueCurrency"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_light"
                android:backgroundTint="@color/button_orange" />
        </LinearLayout>

        <!-- Amount Paid Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/amount_paid"
            android:textColor="@color/light_gray"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/editAmountPaid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0.00"
                android:textColor="@color/text_light"
                android:textSize="32sp"
                android:inputType="numberDecimal"
                android:background="@android:color/transparent"
                android:textColorHint="@color/light_gray"
                android:padding="8dp" />

            <TextView
                android:id="@+id/textPaidCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BGN"
                android:textColor="@color/light_gray"
                android:textSize="24sp"
                android:paddingEnd="8dp"
                android:paddingStart="8dp" />

            <Spinner
                android:id="@+id/spinnerPaidCurrency"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_light"
                android:backgroundTint="@color/button_orange" />
        </LinearLayout>

        <!-- Result Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dark_gray"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/change"
            android:textColor="@color/light_gray"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textResultBGN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.00 BGN"
            android:textColor="@color/text_light"
            android:textSize="28sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textResultEUR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.00 EUR"
            android:textColor="@color/text_light"
            android:textSize="28sp" />

        <!-- Clear Button -->
        <Button
            android:id="@+id/buttonClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear"
            android:textSize="18sp"
            android:backgroundTint="@color/button_orange"
            android:textColor="@color/text_light"
            android:layout_marginTop="24dp"
            android:padding="12dp" />

        <!-- Exchange Rate Info -->
        <TextView
            android:id="@+id/textExchangeRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 EUR = 1.95583 BGN"
            android:textColor="@color/light_gray"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:alpha="0.6" />
    </LinearLayout>

    <!-- Author Info -->
    <TextView
        android:id="@+id/textAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Автор Цветан Царянски"
        android:textColor="@color/light_gray"
        android:textSize="14sp"
        android:alpha="0.7"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
